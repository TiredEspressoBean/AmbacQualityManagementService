# Local development (auto self-signed cert)
localhost {
    encode gzip

    handle /auth/* {
        reverse_proxy backend:8000
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /accounts/* {
        reverse_proxy backend:8000
    }

    handle /admin/* {
        reverse_proxy backend:8000
    }

    handle /media/* {
        reverse_proxy backend:8000
    }

    handle /static/* {
        reverse_proxy backend:8000
    }

    handle /lg/* {
        reverse_proxy host.docker.internal:8123 {
            header_up -X-Forwarded-Proto
        }
        header {
            Access-Control-Allow-Origin *
            Access-Control-Allow-Methods "GET,POST,PUT,DELETE,OPTIONS"
            Access-Control-Allow-Headers "Content-Type,Authorization"
        }
        uri strip_prefix /lg
    }

    # Bare /docs has no trailing slash, so it never matches /docs/* below —
    # without this it falls through to the SPA catch-all and returns index.html.
    handle /docs {
        redir * /docs/ 301
    }

    # Documentation (MkDocs static files).
    #
    # Mounted at /srv/docs, deliberately OUTSIDE /usr/share/caddy. It used to be
    # nested at /usr/share/caddy/docs, inside the frontend-dist volume — but a
    # nested mount is attached at container creation and needs its mountpoint
    # directory to survive in the parent volume. Rebuilding the frontend clears
    # frontend-dist, deletes that directory, and silently orphans the mount:
    # `docker inspect` still lists it while `ls` inside the container reports
    # "No such file or directory", and /docs/ 404s until Caddy is recreated.
    #
    # handle_path (not handle) strips the /docs prefix, so the root can point
    # straight at the docs directory.
    handle_path /docs/* {
        root * /srv/docs
        file_server
    }

    # Ollama passthrough for the in-progress AI feature set. NOT YET WIRED UP --
    # nothing in the app calls /ai/ today; this is the route reserved for it.
    # Leave it in place: it is intentional scaffolding, not dead config.
    #
    # The one thing that was actually broken here: the upstream was 127.0.0.1,
    # which inside this container is Caddy itself, not Ollama on the host.
    # host.docker.internal is the host, same as the /lg/* block above.
    #
    # Position is cosmetic -- Caddy sorts `handle` blocks by matcher specificity
    # and always evaluates the matcher-less catch-all last, so this works above
    # or below it (verified with `caddy adapt`: identical compiled route order).
    # Kept above for readability.
    #
    # strip_prefix maps /ai/api/chat -> /api/chat, matching Ollama's own routes.
    # Revisit that convention when the feature is actually built.
    handle /ai/* {
        reverse_proxy host.docker.internal:11434
        uri strip_prefix /ai
    }

    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }
}
