# Main site (production)
# Configure via environment variables:
#   SITE_DOMAIN - your domain (e.g., qmes.acmecorp.com)
#   TLS_CERT    - path to TLS certificate
#   TLS_KEY     - path to TLS private key
{$SITE_DOMAIN:localhost} {
    tls {$TLS_CERT:/etc/caddy/certs/cert.crt} {$TLS_KEY:/etc/caddy/certs/cert.key}


    encode gzip
    
    # Handle API routes first - most specific to least specific
    handle /auth/* {
        reverse_proxy backend-prod:8000
    }
    
    handle /api/* {
        reverse_proxy backend-prod:8000
    }
    
    handle /accounts/* {
        reverse_proxy backend-prod:8000
    }
    
    handle /admin/* {
        reverse_proxy backend-prod:8000
    }
    
    handle /media/* {
        reverse_proxy backend-prod:8000
    }
    
    handle /static/* {
        reverse_proxy backend-prod:8000
    }
    
    # Handle LangGraph API
    handle /lg/* {
        reverse_proxy host.docker.internal:8123 {
            header_up -X-Forwarded-Proto
        }
        header {
            Access-Control-Allow-Origin *
            Access-Control-Allow-Methods "GET,POST,PUT,DELETE,OPTIONS"
            Access-Control-Allow-Headers "Content-Type,Authorization"
        }
        uri strip_prefix /lg
    }

    # Documentation (MkDocs static files)
    handle /docs/* {
        root * /usr/share/caddy
        file_server
    }

    # Handle SPA routes (fallback)
    # Ollama passthrough for the in-progress AI feature set. NOT YET WIRED UP --
    # nothing in the app calls /ai/ today; this is the route reserved for it.
    # Leave it in place: it is intentional scaffolding, not dead config.
    #
    # The one thing that was actually broken here: the upstream was 127.0.0.1,
    # which inside this container is Caddy itself, not Ollama on the host.
    # host.docker.internal is the host, same as the /lg/* block above.
    #
    # Position is cosmetic -- Caddy sorts `handle` blocks by matcher specificity
    # and always evaluates the matcher-less catch-all last, so this works above
    # or below it (verified with `caddy adapt`: identical compiled route order).
    # Kept above for readability.
    #
    # strip_prefix maps /ai/api/chat -> /api/chat, matching Ollama's own routes.
    # Revisit that convention when the feature is actually built.
    handle /ai/* {
        reverse_proxy {$OLLAMA_UPSTREAM:host.docker.internal:11434}
        uri strip_prefix /ai
    }

    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }
}

