# =============================================================================
# .env.docker.example -- template for the Docker Compose stack
# =============================================================================
#
#   cp .env.docker.example .env.docker    then fill in the marked values
#
# .env.docker is gitignored. It is loaded per-service via `env_file:` in
# docker-compose.yml, which injects these into the containers. That is NOT the
# same as compose's `--env-file` / ${...} interpolation, which reads ./.env --
# a handful of values (POSTGRES_PASSWORD, REDIS_PASSWORD, SITE_DOMAIN,
# BACKUP_ENCRYPTION_KEY, BACKUP_PATH) come from there instead and are noted below.
#
# Hostnames here are docker-network service names (postgres, redis), not
# localhost -- that is the main way this file differs from .env, which is for
# running the backend directly on the host.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED -- the stack will not start without these
# -----------------------------------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE-ME

# Column-level encryption for LLM API keys and integration secrets
# (django-encrypted-model-fields). Required whenever DJANGO_DEBUG=False, which
# is the default below: settings._resolve_secret fails closed on a real
# deployment rather than falling back to a key committed to source.
# backend-prod asserts this is set before it runs migrate, so a missing value
# gives you a one-line error instead of a Django traceback.
#
# ROTATING THIS INVALIDATES EVERY EXISTING ENCRYPTED VALUE. Treat it as
# permanent for the life of the stack, and keep it identical across all
# services -- the celery workers encrypt and decrypt the same columns the web
# container does.
#
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CHANGE-ME

# Fail-safe default. Every service inheriting this file gets the
# production-safe posture; the three `local`-profile services (backend,
# celery-worker, celery-beat) opt back into DEBUG=True explicitly in
# docker-compose.yml. Deliberately inverted: when the default was True, each
# -prod service had to override it and two were missed, which left the
# production celery workers in DEBUG while their web container was not --
# and DEBUG decides how password-reset links are built (settings.py:579),
# so those workers were emailing http://localhost:5173 links.
#
# Leave this False. To debug the local stack, it is already True there.
DJANGO_DEBUG=False

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# NOTE: docker-compose.yml sets DATABASE_URL itself, derived from the same
# ${POSTGRES_USER}/${POSTGRES_PASSWORD}/${POSTGRES_DB} compose variables that
# the postgres service uses, so the app and the server can never disagree.
# Set POSTGRES_PASSWORD in ./.env (not here) -- that is the file compose reads
# for ${...} interpolation. These values are the fallback settings.py uses only
# if DATABASE_URL is absent.
POSTGRES_DB=tracker_AMBAC
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis / Celery
# -----------------------------------------------------------------------------
# docker-compose.yml overrides these with password-bearing URLs built from
# ${REDIS_PASSWORD} (set it in ./.env). Kept here for a non-compose run.
REDIS_HOST=redis
CELERY_BROKER_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# -----------------------------------------------------------------------------
# Deployment mode -- multi-tenant vs. single instance
# -----------------------------------------------------------------------------
# settings.py DEFAULTS TO "saas" when this is unset, so leaving it out gives you
# the multi-tenant path by accident. Set it explicitly.
#
#   dedicated -- one tenant, no tenant selection UI. TenantMiddleware skips
#                resolution entirely and always returns DEFAULT_TENANT_SLUG
#                (auto-created on first run). Correct for a local stack or an
#                on-prem single-customer install.
#   saas      -- multi-tenant. Resolution is X-Tenant-ID header -> session ->
#                subdomain -> user's default. Needs TENANT_BASE_DOMAIN plus
#                wildcard DNS and a *.<domain> cert on the proxy to be useful.
#
# Note DEFAULT_TENANT_SLUG below is only authoritative in dedicated mode; in
# saas mode it is ignored and the tenant comes from the request.
#
# !! DEFAULT_TENANT_SLUG MUST MATCH A TENANT THAT ACTUALLY EXISTS in the DB, or
# dedicated mode forks your data. _get_default_tenant() resolves: exact slug ->
# else the sole tenant if there is exactly one (logs a drift warning) -> else
# get_or_create(slug). So with 2+ tenants and a slug matching none of them, it
# CREATES a new empty tenant and every request resolves there -- you log in to
# an empty system while the seeded data sits in the tenant you can no longer
# reach. Note the seeders do NOT use "ambac": seed_demo creates slug "demo",
# seed_dev creates "dev". Check before switching modes:
#   docker compose exec postgres psql -U postgres -d tracker_AMBAC #     -c 'select slug, name from "Tracker_tenant";'
DEPLOYMENT_MODE=dedicated
DEFAULT_TENANT_NAME=My Company
DEFAULT_TENANT_SLUG=ambac

# --- saas mode only, ignored in dedicated ---
# TENANT_BASE_DOMAIN=uqmes.com       # acme.uqmes.com -> tenant "acme"
# CUSTOM_DOMAINS=uqmes.com           # our own domain + subdomains, for CORS/CSRF
# DEMO_TENANT_SLUG=demo
# RESERVED_TENANT_SLUGS=www,api,app  # infra subdomains only, never a real slug

# -----------------------------------------------------------------------------
# First admin
# -----------------------------------------------------------------------------
# Consumed by `manage.py create_temp_admin`, which only the local profile runs.
# All three must be set or the command errors.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=CHANGE-ME

# -----------------------------------------------------------------------------
# URLs, CORS, CSRF
# -----------------------------------------------------------------------------
# ALLOWED_HOSTS: only needed if you are NOT using the compose production
# profile, which derives it from ${SITE_DOMAIN} in ./.env. Django enforces it
# whenever DEBUG=False, and the settings.py default covers only localhost and
# the Railway/Azure hosts -- so a self-hosted internal name must be listed or
# every request gets 400 DisallowedHost. Comma-separated, no scheme.
# ALLOWED_HOSTS=uqmes.internal.example.com,localhost,127.0.0.1

# FRONTEND_URL is what outbound email links are built from when DEBUG=False
# (invitations, password resets). Include the scheme in a real deployment.
FRONTEND_URL=https://localhost

# Caddy terminates TLS, so include both schemes for whatever hostname you use.
# docker-compose.yml also injects values built from ${SITE_DOMAIN} (from ./.env).
CORS_ALLOWED_ORIGINS=https://localhost,http://localhost
CSRF_TRUSTED_ORIGINS=https://localhost,http://localhost
CORS_ALLOW_CREDENTIALS=true

# Relative: Caddy proxies /api to the backend, so the built frontend needs no
# absolute API host for the local profile.
VITE_API_TARGET=

# -----------------------------------------------------------------------------
# django-tailwind
# -----------------------------------------------------------------------------
# settings.py reads NPM_BIN_PATH; the backend image installs nodejs + npm for it.
NPM_BIN_PATH=/usr/bin/npm

# -----------------------------------------------------------------------------
# OPTIONAL -- leave blank or omit to disable the feature
# -----------------------------------------------------------------------------

# SSO. false is correct unless you have an Azure app registered.
SSO_ENABLED=false
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=common

# Email. Omit EMAIL_BACKEND entirely to fall back to console output, which is
# usually what you want locally -- invitation links are also copyable from the
# UI at /admin/users, so onboarding works with no mail path at all.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=

# Integrations
# HUBSPOT_API_KEY=
# LANGSMITH_API_KEY=
